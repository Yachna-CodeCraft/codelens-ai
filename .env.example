MONGO_URI=mongodb://localhost:27017
MONGO_DB=codelens
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=60

# Optional: enables AI summaries and the code assistant.
# Without it, the assistant returns the most relevant code snippets only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
